{
  "name": "@ffmpeg/core-video",
  "version": "0.12.6",
  "description": "FFmpeg WebAssembly version specialized for PNG-frames-to-video (single thread)",
  "main": "./dist/umd/ffmpeg-core.js",
  "exports": {
    ".": {
      "import": "./dist/esm/ffmpeg-core.js",
